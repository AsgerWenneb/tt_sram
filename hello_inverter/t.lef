VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO t
  CLASS BLOCK ;
  FOREIGN t ;
  ORIGIN 0.000 0.000 ;
  SIZE 10.000 BY 5.000 ;
  PIN A
    DIRECTION INPUT ;
    PORT
      LAYER met2 ;
        RECT 0.000 0.000 1.000 2.000 ;
    END
  END A
  PIN Y
    DIRECTION OUTPUT ;
    PORT
      LAYER met2 ;
        RECT 8.000 0.000 10.000 2.000 ;
    END
  END Y
  PIN VPWR
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met4 ;
        RECT 0.000 3.000 1.000 5.000 ;
    END
  END VPWR
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met4 ;
        RECT 8.000 3.000 10.000 5.000 ;
    END
  END VGND
  OBS
      LAYER li1 ;
        RECT 0.100 3.100 0.900 4.900 ;
        RECT 8.100 3.100 9.900 4.900 ;
      LAYER met1 ;
        RECT 0.000 3.000 1.000 5.000 ;
        RECT 8.000 3.000 10.000 5.000 ;
        RECT 0.000 0.000 1.000 2.000 ;
        RECT 8.000 0.000 10.000 2.000 ;
      LAYER met2 ;
        RECT 0.000 3.000 1.000 5.000 ;
        RECT 8.000 3.000 10.000 5.000 ;
      LAYER met3 ;
        RECT 0.000 3.000 1.000 5.000 ;
        RECT 8.000 3.000 10.000 5.000 ;
  END
END t
END LIBRARY

